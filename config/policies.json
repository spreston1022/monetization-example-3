{
  "policies": [
    {
      "name": "monetization-posts-inbound",
      "policyType": "monetization-inbound",
      "handler": {
        "export": "MonetizationInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "cacheTtlSeconds": 60,
          "meters": {
            "posts_requests": 1
          },
          "requiredEntitlements": ["posts_requests"]
        }
      }
    },
    {
      "name": "monetization-users-inbound",
      "policyType": "monetization-inbound",
      "handler": {
        "export": "MonetizationInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "cacheTtlSeconds": 60,
          "meters": {
            "users_requests": 1
          },
          "requiredEntitlements": ["users_requests"]
        }
      }
    },
    {
      "name": "rate-limit-by-plan-inbound",
      "policyType": "rate-limit-inbound",
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "function",
          "requestsAllowed": 10,
          "timeWindowMinutes": 1,
          "identifier": {
            "export": "default",
            "module": "$import(./modules/rate-limit-by-plan)"
          }
        }
      }
    }
  ]
}
